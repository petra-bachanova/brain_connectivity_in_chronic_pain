df$is_patient = as.factor(df$is_patient)
df = df[df$time == 1 & !is.na(df$pain_avg), ]
T1 = table1(
~ gender +
age +
weight +
ethnicity +
pain_avg +
promis_dep_t1 +
promis_anger_t1 +
promis_anxiety_t1 +
promis_sleep_t1 | is_patient, data=df,
render.continuous=c( .="Median [Min, Max]"))
write.table(T1, "../Data/240502_table1.csv")
T1
