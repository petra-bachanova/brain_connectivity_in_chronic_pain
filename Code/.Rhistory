library(ggplot2)
df = read.csv("../Data/240505_metadata_prepped.csv")
df = df[df$time == 1, ]
df[df$is_patient == 0, ]$backpain_length = 0
df_melt <- melt(df[cols], na.rm = TRUE, id.vars = "is_patient")
cols = c(
"is_patient", "gender", "age", "weight", "ethnicity", "backpain_length", "pain_avg_t1", "n_spike_regs_sponpain",
"promis_dep_t1", "promis_anger_t1", "promis_anxiety_t1", "negative_affect_t1", "promis_sleep_t1", "bpi_intensity_t1",
"bpi_interference_t1", "odi_t1")
df_melt <- melt(df[cols], na.rm = TRUE, id.vars = "is_patient")
ggplot(data=df_melt, aes(x=variable, y=value, fill=is_patient)) +
geom_violin(trim=FALSE)
ggplot(data=df_melt[df_melt$variable %in% vars_basic], aes(x=variable, y=value, fill=is_patient)) +
geom_violin()
vars_basic = c("age", "weight", "n_spike_regs_sponpain")
vars_pain = c("backpain_length", "pain_avg_t1", "odi_t1", "bpi_intensity_t1", "bpi_interference_t1")
vars_promis = c("promis_anxiety_t1", "promis_dep_t1", "promis_anger_t1", "negative_affect_t1", "promis_sleep_t1")
ggplot(data=df_melt[df_melt$variable %in% vars_basic], aes(x=variable, y=value, fill=is_patient)) +
geom_violin()
ggplot(data=df_melt[df_melt$variable %in% vars_basic, ], aes(x=variable, y=value, fill=is_patient)) +
geom_violin()
df_melt <- melt(df[cols], na.rm = TRUE, id.vars = "is_patient")
df_melt$is_patient[df_melt$is_patient == 0] <- "HC"
df_melt$is_patient[df_melt$is_patient == 1] <- "CBP"
vars_basic = c("age", "weight", "n_spike_regs_sponpain")
vars_pain = c("backpain_length", "pain_avg_t1", "odi_t1", "bpi_intensity_t1", "bpi_interference_t1")
vars_promis = c("promis_anxiety_t1", "promis_dep_t1", "promis_anger_t1", "negative_affect_t1", "promis_sleep_t1")
ggplot(data=df_melt[df_melt$variable %in% vars_basic, ], aes(x=variable, y=value, fill=is_patient)) +
geom_violin()
vars_basic = c("age", "weight")
ggplot(data=df_melt[df_melt$variable %in% vars_basic, ], aes(x=variable, y=value, fill=is_patient)) +
geom_violin()
ggplot(data=df_melt[df_melt$variable %in% vars_basic, ], aes(x=variable, y=value, fill=is_patient)) +
geom_violin() + geom_boxplot(width=0.1)
ggplot(data=df_melt[df_melt$variable %in% vars_basic, ], aes(x=variable, y=value, fill=is_patient)) +
geom_violin() + geom_boxplot(width=0.1, fill=is_patient)
ggplot(data=df_melt[df_melt$variable %in% vars_basic, ], aes(x=variable, y=value, fill=is_patient)) +
geom_violin()
df_melt$is_patient <- factor(df_melt$is_patient, levels=c("HC", "CBP"))
ggplot(data=df_melt[df_melt$variable %in% vars_basic, ], aes(x=variable, y=value, fill=is_patient)) +
