library(ggplot2)
library(table1)
library(reshape2)
library(ggplot2)
# functions
get_upper_tri <- function(cor){
cor[lower.tri(cor)]<- NA
return(cor)
}
df = read.csv("../Data/240502_metadata_prepped.csv")
df$is_patient = as.factor(df$is_patient)
df = df[df$time == 1 & !is.na(df$pain_avg), ]
T1 = table1(
~ gender +
age +
weight +
ethnicity +
