library(ggplot2)
library(table1)
df = read.csv("../Data/240424_metadata_prepped.csv")
df$is_patient = as.factor(df$is_patient)
df = df[df$time == 1 & !is.na(df$pain_avg), ]
T1 = table1(
~ gender +
age +
weight +
ethnicity +
pain_avg +
promis_dep_baseline +
promis_anger_baseline +
promis_anxiety_baseline +
promis_sleep_baseline | is_patient, data=df,
render.continuous=c( .="Median [Min, Max]"))
T1
# libraries
library(ggplot2)
library(table1)
library(reshape2)
library(ggplot2)
# functions
get_upper_tri <- function(cor){
cor[lower.tri(cor)]<- NA
return(cor)
}
df = read.csv("../Data/240424_metadata_prepped.csv")
df$is_patient = as.factor(df$is_patient)
df = df[df$time == 1 & !is.na(df$pain_avg), ]
T1 = table1(
~ gender +
age +
weight +
ethnicity +
pain_avg +
promis_dep_baseline +
promis_anger_baseline +
promis_anxiety_baseline +
promis_sleep_baseline | is_patient, data=df,
render.continuous=c( .="Median [Min, Max]"))
cols = c("is_patient", "gender", "age", "weight", "ethnicity", "pain_avg", "promis_dep_baseline", "promis_anger_baseline", "promis_anxiety_baseline", "promis_sleep_baseline")
df_num = na.omit(df[cols])  # remove Nan & subset interesting cols
df_num <- apply(df_num, 2, function(x) as.numeric(x))
cormat <- round(cor(df_num),2) # get correlations
upper_tri <- get_upper_tri(cormat)
melted_cormat <- melt(upper_tri, na.rm = TRUE)
gg_heat <- ggplot(data = melted_cormat, aes(Var2, Var1, fill = value)) +
geom_tile(color = "white") +
scale_fill_gradient2(
low = "blue", high = "red", mid = "white",
midpoint = 0, limit = c(-1,1),
space = "Lab",
name="Pearson\nCorrelation") +
theme_minimal() +
theme(
axis.text.x = element_text(angle = 45, vjust = 1, size = 12, hjust = 1)) +
coord_fixed()
gg_heat +
geom_text(aes(Var2, Var1, label = value), color = "black", size = 4) +
theme(
axis.title.x = element_blank(),
axis.title.y = element_blank(),
panel.grid.major = element_blank(),
panel.border = element_blank(),
panel.background = element_blank(),
axis.ticks = element_blank(),
legend.justification = c(1, 0),
legend.position = c(0.6, 0.7),
legend.direction = "horizontal")+
guides(fill = guide_colorbar(barwidth = 7, barheight = 1,
title.position = "top", title.hjust = 0.5))
T1
